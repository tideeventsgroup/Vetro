generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x is what the query engine
  // needs to actually run on Lambda's Amazon Linux 2023 Node 20 runtime —
  // without it the locally-generated binary silently doesn't work there.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ComplianceStatus {
  ACTIVE
  EXPIRING
  EXPIRED
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ShiftStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  MISSED
  LATE
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CASUAL
  ZERO_HOURS
}

// Distinct from ComplianceStatus (licence/vetting state) — this is whether
// the person is currently a working employee at all, the baseline fact an
// HR record exists to answer before compliance status is even relevant.
enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  LEFT
}

enum PayRateType {
  HOURLY
  DAILY
  SALARY
}

enum IncidentCategory {
  THEFT
  VANDALISM
  TRESPASSING
  MEDICAL
  FIRE_SAFETY
  EQUIPMENT_FAULT
  SUSPICIOUS_ACTIVITY
  OTHER
}

// The tenant boundary. `slug` is the subdomain — clyde-coast.vetro.co.uk —
// and is how a request is scoped, either via the Cognito user's
// custom:contractor_id claim or, in local dev, the X-Vetro-Tenant header
// (see backend/src/lib/auth.ts).
model Contractor {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  officers          Officer[]
  sites             Site[]
  shifts            Shift[]
  incidents         Incident[]
  checkpoints       Checkpoint[]
  checkpointScans   CheckpointScan[]
  visitorLogEntries VisitorLogEntry[]
  messages          Message[]
  alerts            Alert[]
  createdAt         DateTime          @default(now())
}

// A client's site/contract — what officers are actually scheduled against.
// clientContactName/Email are who gets invited as the CLIENT self-service
// login for this one site (custom:site_id scopes that login to just this
// row — see backend/src/lib/auth.ts's requireClientSelf).
model Site {
  id                 String            @id @default(cuid())
  contractorId       String
  contractor         Contractor        @relation(fields: [contractorId], references: [id])
  name               String
  address            String?
  clientContactName  String?
  clientContactEmail String?
  // Geofence centre + radius for GPS-verified clock-in/out. All three are
  // optional together — a site with no coordinates set skips geofence
  // enforcement entirely rather than blocking clock-in on missing data.
  latitude           Float?
  longitude          Float?
  geofenceRadiusM    Int?
  shifts             Shift[]
  incidents          Incident[]
  checkpoints        Checkpoint[]
  visitorLogEntries  VisitorLogEntry[]
  createdAt          DateTime          @default(now())

  @@index([contractorId])
}

// A scheduled slot at a site, optionally assigned to an officer. Status is
// set by hand here (unlike SiaLicence/VettingRecord, there's no external
// register to check against) — SCHEDULED/CONFIRMED come from the admin who
// built the roster, COMPLETED/MISSED/LATE come from the client's own
// confirmation (routes/client.ts) once the shift has actually happened.
model Shift {
  id                String      @id @default(cuid())
  contractorId      String
  contractor        Contractor  @relation(fields: [contractorId], references: [id])
  siteId            String
  site              Site        @relation(fields: [siteId], references: [id])
  officerId         String?
  officer           Officer?    @relation(fields: [officerId], references: [id])
  startTime         DateTime
  endTime           DateTime
  status            ShiftStatus @default(SCHEDULED)
  clientConfirmedAt DateTime?
  incidentNotes     String?
  clockInAt         DateTime?
  clockInLat        Float?
  clockInLng        Float?
  clockInAccuracyM  Float?
  clockInDistanceM  Float?
  clockOutAt        DateTime?
  clockOutLat       Float?
  clockOutLng       Float?
  clockOutAccuracyM Float?
  clockOutDistanceM Float?
  // Live-tracking position, refreshed by a periodic ping from the officer's
  // own device while clocked in (routes/me.ts's PATCH .../ping) — distinct
  // from the one-time clockIn*/clockOut* snapshots above, which never move
  // again once recorded. Powers the admin Live Ops map's "where is everyone
  // right now" view.
  lastLat           Float?
  lastLng           Float?
  lastLocationAt    DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([contractorId])
  @@index([siteId])
  @@index([officerId])
  @@index([startTime])
}

model Officer {
  id                           String              @id @default(cuid())
  contractorId                 String
  contractor                   Contractor          @relation(fields: [contractorId], references: [id])
  firstName                    String
  lastName                     String
  email                        String?
  phone                        String?
  // Personal details
  dateOfBirth                  DateTime?
  nationalInsuranceNumber      String?
  addressLine1                 String?
  addressLine2                 String?
  city                         String?
  postcode                     String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?
  // Employment details — separate from ComplianceStatus (licence/vetting),
  // which answers "cleared to work"; these answer "employed at all, doing
  // what, since when, paid how".
  employeeNumber               String?
  jobTitle                     String?
  employmentType               EmploymentType?
  employmentStatus             EmploymentStatus    @default(ACTIVE)
  startDate                    DateTime?
  leaveDate                    DateTime?
  payRate                      Float?
  payRateType                  PayRateType?
  rightToWorkConfirmed         Boolean             @default(false)
  rightToWorkCheckedAt         DateTime?
  licences                     SiaLicence[]
  vettingRecords               VettingRecord[]
  qualifications               Qualification[]
  documents                    Document[]
  vettingSubmissions           VettingSubmission[]
  shifts                       Shift[]
  incidents                    Incident[]
  checkpointScans              CheckpointScan[]
  visitorLogEntries            VisitorLogEntry[]
  messagesReceived             Message[]
  messageReads                 MessageRead[]
  alerts                       Alert[]
  createdAt                    DateTime            @default(now())
  updatedAt                    DateTime            @updatedAt

  @@index([contractorId])
}

// SIA licence held by an officer. `status` is derived by the scheduled
// expiry-check job (backend/src/jobs/checkExpiries.ts), not set by hand,
// since Vetro's whole pitch is that this is checked, not entered.
model SiaLicence {
  id            String           @id @default(cuid())
  officerId     String
  officer       Officer          @relation(fields: [officerId], references: [id])
  licenceNumber String
  sector        String
  issueDate     DateTime
  expiryDate    DateTime
  status        ComplianceStatus @default(ACTIVE)
  lastCheckedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([officerId])
  @@index([expiryDate])
}

model VettingRecord {
  id            String           @id @default(cuid())
  officerId     String
  officer       Officer          @relation(fields: [officerId], references: [id])
  standard      String           @default("BS7858")
  completedDate DateTime
  expiryDate    DateTime?
  status        ComplianceStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([officerId])
  @@index([expiryDate])
}

// What an officer submits themselves through the self-service portal —
// Vetro still doesn't perform the BS7858 check; this is the record an
// admin reviews before turning it into (or updating) a VettingRecord.
model VettingSubmission {
  id                String           @id @default(cuid())
  officerId         String
  officer           Officer          @relation(fields: [officerId], references: [id])
  addressHistory    Json
  employmentHistory Json
  references        Json
  consentGiven      Boolean
  status            SubmissionStatus @default(PENDING_REVIEW)
  reviewedAt        DateTime?
  reviewedBy        String?
  reviewNotes       String?
  submittedAt       DateTime         @default(now())

  @@index([officerId])
}

model Qualification {
  id         String    @id @default(cuid())
  officerId  String
  officer    Officer   @relation(fields: [officerId], references: [id])
  name       String
  issuedBy   String?
  issueDate  DateTime?
  expiryDate DateTime?
  createdAt  DateTime  @default(now())

  @@index([officerId])
}

model Document {
  id         String   @id @default(cuid())
  officerId  String
  officer    Officer  @relation(fields: [officerId], references: [id])
  kind       String
  s3Key      String
  uploadedAt DateTime @default(now())

  @@index([officerId])
}

// Filed by whichever officer was on-site — the one feature every guard
// management product (Silvertrac, Trackforce, TimeGate+) treats as core,
// and doubles as extra evidence for an ACS inspection alongside the
// compliance record. photoKeys are S3 keys from the same presigned-upload
// flow as Document (lib/documents.ts), just under an "incidents/" prefix.
model Incident {
  id           String           @id @default(cuid())
  contractorId String
  contractor   Contractor       @relation(fields: [contractorId], references: [id])
  siteId       String
  site         Site             @relation(fields: [siteId], references: [id])
  officerId    String
  officer      Officer          @relation(fields: [officerId], references: [id])
  category     IncidentCategory
  description  String
  occurredAt   DateTime
  photoKeys    String[]
  latitude     Float?
  longitude    Float?
  accuracyM    Float?
  createdAt    DateTime         @default(now())

  @@index([contractorId])
  @@index([siteId])
  @@index([officerId])
  @@index([occurredAt])
}

// A patrol route is just a named set of checkpoints at a site. Each
// checkpoint carries a printable QR code (a random opaque token, not the
// row id, so a photographed/shared QR doesn't leak a guessable-looking
// primary key) that an officer scans with their phone camera to log a
// visit; coordinates are optional and only enforced if an admin sets them,
// same opt-in pattern as Site's clock-in geofence.
model Checkpoint {
  id              String           @id @default(cuid())
  contractorId    String
  contractor      Contractor       @relation(fields: [contractorId], references: [id])
  siteId          String
  site            Site             @relation(fields: [siteId], references: [id])
  name            String
  description     String?
  qrCode          String           @unique @default(cuid())
  latitude        Float?
  longitude       Float?
  geofenceRadiusM Int?
  scans           CheckpointScan[]
  createdAt       DateTime         @default(now())

  @@index([contractorId])
  @@index([siteId])
}

model CheckpointScan {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id])
  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id])
  officerId    String
  officer      Officer    @relation(fields: [officerId], references: [id])
  latitude     Float?
  longitude    Float?
  accuracyM    Float?
  scannedAt    DateTime   @default(now())

  @@index([contractorId])
  @@index([checkpointId])
  @@index([officerId])
  @@index([scannedAt])
}

// A site-level sign-in/out register — common wherever a site itself
// controls who's allowed past reception, recorded by whichever officer is
// on duty rather than the visitor self-serving it.
model VisitorLogEntry {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id])
  siteId       String
  site         Site       @relation(fields: [siteId], references: [id])
  officerId    String
  officer      Officer    @relation(fields: [officerId], references: [id])
  visitorName  String
  company      String?
  purpose      String?
  hostName     String?
  signedInAt   DateTime   @default(now())
  signedOutAt  DateTime?

  @@index([contractorId])
  @@index([siteId])
  @@index([officerId])
  @@index([signedInAt])
}

// Dispatch messaging — an admin broadcasts to every officer (recipientId
// null) or messages one officer directly. Officers only ever read here
// (see requireOfficerSelf-scoped /me/messages), never send: this is a
// control-room-to-field channel, not officer-to-officer chat. Polling-based
// for now (no websocket infra), so readAt is what drives the unread badge
// rather than a push event.
model Message {
  id           String        @id @default(cuid())
  contractorId String
  contractor   Contractor    @relation(fields: [contractorId], references: [id])
  senderEmail  String
  recipientId  String?
  recipient    Officer?      @relation(fields: [recipientId], references: [id])
  body         String
  createdAt    DateTime      @default(now())
  reads        MessageRead[]

  @@index([contractorId])
  @@index([recipientId])
  @@index([createdAt])
}

// Cascades on both sides: a deleted message has no reads worth keeping, and
// a deleted officer's read receipts are meaningless without the officer —
// unlike CheckpointScan/VisitorLogEntry (real records of what happened),
// this table only ever answers "has X seen Y", so nothing is lost by letting
// it disappear with either side.
model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  officerId String
  officer   Officer  @relation(fields: [officerId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, officerId])
  @@index([officerId])
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// A lone-worker panic/SOS alert — an officer presses one button (deliberately
// not gated by requireVettingCompleted, since a safety escape hatch has no
// business waiting on admin approval) and it lands here with a GPS fix if
// one was available. OPEN means nobody at the office has seen it yet;
// ACKNOWLEDGED means someone has and is responding; RESOLVED closes it out.
model Alert {
  id                  String      @id @default(cuid())
  contractorId        String
  contractor          Contractor  @relation(fields: [contractorId], references: [id])
  officerId           String
  officer             Officer     @relation(fields: [officerId], references: [id])
  latitude            Float?
  longitude           Float?
  accuracyM           Float?
  status              AlertStatus @default(OPEN)
  acknowledgedAt      DateTime?
  acknowledgedByEmail String?
  resolvedAt          DateTime?
  createdAt           DateTime    @default(now())

  @@index([contractorId])
  @@index([officerId])
  @@index([status])
}

// Every write an ACS inspector or client export might need to prove happened.
// contractorId is nullable only because it postdates this table — every
// call site that exists has one available and always passes it now (see
// backend/src/lib/audit.ts); older rows from before this column existed
// just show with no tenant attributed.
model AuditLogEntry {
  id           String   @id @default(cuid())
  contractorId String?
  actorEmail   String
  action       String
  entityType   String
  entityId     String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([contractorId, createdAt])
}
