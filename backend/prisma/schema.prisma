generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x is what the query engine
  // needs to actually run on Lambda's Amazon Linux 2023 Node 20 runtime —
  // without it the locally-generated binary silently doesn't work there.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// The checks Lunara Screening actually performs itself (Phase 1-2, no
// accreditation required) — see docs/BRAND_GUIDELINES.md and the product
// brief for what's deliberately NOT here: DBS_CHECK is tracked status only,
// never a real disclosure check. It exists so an org can note "this role
// needs a DBS and here's where that stands," not to collect or process any
// actual criminal record data — there is deliberately no document upload
// path for it (see candidatePublic.ts's upload endpoints, which reject it),
// and every check of this type is disclaimed in the UI as "pending partner
// integration." An actual PVG/Disclosure Scotland/DBS *check* is still a
// Phase 3 decision that needs an accredited partner integration first, not
// a migration.
enum CheckType {
  SIA_LICENCE
  FIRST_AID
  RIGHT_TO_WORK
  ID_DOCUMENT
  TRAINING
  DBS_CHECK
}

enum CheckStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  EXPIRED
  REJECTED
}

// A candidate's own progress through onboarding — distinct from CheckStatus
// (which check-by-check role toward the dashboard's colour coding).
enum CandidateStatus {
  INVITED
  IN_PROGRESS
  SUBMITTED
  ARCHIVED
}

enum DataRequestType {
  ACCESS
  DELETE
}

enum DataRequestStatus {
  PENDING
  COMPLETED
}

// The tenant boundary. `slug` is the subdomain — an org's own
// {slug}.lunarascreening.co.uk — resolved either via the Cognito user's
// custom:contractor_id claim or, in local dev, the X-Lunara-Tenant header
// (see backend/src/lib/auth.ts). retentionDays is the org's own configured
// document/check retention period — the expiry job (jobs/checkExpiries.ts)
// flags anything older than this for deletion rather than the product
// hardcoding a period across every org.
model Organisation {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  retentionDays Int           @default(365)
  roleTypes     RoleType[]
  candidates    Candidate[]
  createdAt     DateTime      @default(now())
}

// An org's own configurable "what does this job need" mapping — chosen at
// invite time (routes/candidates.ts), so a candidate's self-service form
// only ever asks for the checks their actual role requires.
model RoleType {
  id                 String      @id @default(cuid())
  organisationId     String
  organisation       Organisation @relation(fields: [organisationId], references: [id])
  name               String
  requiredCheckTypes CheckType[]
  candidates         Candidate[]
  createdAt          DateTime    @default(now())

  @@unique([organisationId, name])
  @@index([organisationId])
}

// A person invited to submit their compliance documents. inviteToken is
// the magic-link credential (routes/candidatePublic.ts) — a candidate has
// no Cognito account; the token itself, not a session, is what authorises
// their own access to their record, the same way it always has for Lunara.
model Candidate {
  id             String          @id @default(cuid())
  organisationId String
  organisation   Organisation    @relation(fields: [organisationId], references: [id])
  firstName      String
  lastName       String
  email          String
  roleTypeId     String?
  roleType       RoleType?       @relation(fields: [roleTypeId], references: [id])
  status         CandidateStatus @default(INVITED)
  inviteToken    String          @unique
  invitedByEmail String
  checks         Check[]
  dataRequests   DataRequest[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([organisationId])
}

// One row per required check for a candidate — created the moment a
// candidate is invited (one per requiredCheckTypes entry on their
// RoleType), starting NOT_STARTED until they submit something.
//
// licenceNumber/expiryDate are used differently per checkType: SIA_LICENCE
// verification is a deep-link-assisted manual confirm against the official
// public Register of Licence Holders (no public API exists to automate
// this — see lib/siaRegister.ts); FIRST_AID/RIGHT_TO_WORK/TRAINING track a
// self-reported expiry date an admin can review; ID_DOCUMENT has no expiry
// concept and is purely human-reviewed; DBS_CHECK never gets a document at
// all (candidatePublic.ts's upload routes reject it) — an admin can only
// move it between NOT_STARTED/PENDING/REJECTED by hand as a plain status
// note, since Lunara Screening doesn't perform or receive an actual DBS
// check.
model Check {
  id            String      @id @default(cuid())
  candidateId   String
  candidate     Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  checkType     CheckType
  status        CheckStatus @default(NOT_STARTED)
  licenceNumber String?
  expiryDate    DateTime?
  verifiedAt    DateTime?
  verifiedBy    String?
  notes         String?
  documents     Document[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([candidateId])
  @@index([checkType])
  @@index([expiryDate])
}

// A document a candidate uploaded against one of their checks — the same
// two-step presigned-S3-upload flow as every document upload in this app
// (lib/documents.ts), stored in a private bucket, never public. A check
// can carry more than one document (e.g. an ID document's front and back).
model Document {
  id          String   @id @default(cuid())
  checkId     String
  check       Check    @relation(fields: [checkId], references: [id], onDelete: Cascade)
  storagePath String
  fileName    String
  fileType    String?
  uploadedAt  DateTime @default(now())

  @@index([checkId])
}

// A candidate's own GDPR request — self-serve via their magic link
// (routes/candidatePublic.ts), resolved by an admin (routes/dataRequests.ts).
// ACCESS just needs an admin to confirm they've supplied the data (the
// candidate can already see everything themselves via their own link);
// DELETE actually removes the candidate's checks/documents/record once
// resolved. candidateId is nullable + SET NULL (not the usual RESTRICT/
// CASCADE) specifically so this row — proof a delete request really was
// fulfilled — survives the candidate row it's about being deleted.
model DataRequest {
  id             String            @id @default(cuid())
  candidateId    String?
  candidate      Candidate?        @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  organisationId String
  type           DataRequestType
  status         DataRequestStatus @default(PENDING)
  requestedAt    DateTime          @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?

  @@index([candidateId])
  @@index([organisationId])
}

// Every write an auditor or client due-diligence request might need to
// prove happened — status changes, document views, everything. Core to a
// compliance product, not an afterthought.
model AuditLogEntry {
  id             String   @id @default(cuid())
  organisationId String?
  actorEmail     String
  action         String
  entityType     String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([organisationId, createdAt])
}
