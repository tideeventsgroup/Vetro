generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x is what the query engine
  // needs to actually run on Lambda's Amazon Linux 2023 Node 20 runtime —
  // without it the locally-generated binary silently doesn't work there.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ComplianceStatus {
  ACTIVE
  EXPIRING
  EXPIRED
}

enum SubmissionStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ShiftStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  MISSED
  LATE
}

enum IncidentCategory {
  THEFT
  VANDALISM
  TRESPASSING
  MEDICAL
  FIRE_SAFETY
  EQUIPMENT_FAULT
  SUSPICIOUS_ACTIVITY
  OTHER
}

// The tenant boundary. `slug` is the subdomain — clyde-coast.vetro.co.uk —
// and is how a request is scoped, either via the Cognito user's
// custom:contractor_id claim or, in local dev, the X-Vetro-Tenant header
// (see backend/src/lib/auth.ts).
model Contractor {
  id                String            @id @default(cuid())
  name              String
  slug              String            @unique
  officers          Officer[]
  sites             Site[]
  shifts            Shift[]
  incidents         Incident[]
  checkpoints       Checkpoint[]
  checkpointScans   CheckpointScan[]
  visitorLogEntries VisitorLogEntry[]
  createdAt         DateTime          @default(now())
}

// A client's site/contract — what officers are actually scheduled against.
// clientContactName/Email are who gets invited as the CLIENT self-service
// login for this one site (custom:site_id scopes that login to just this
// row — see backend/src/lib/auth.ts's requireClientSelf).
model Site {
  id                 String            @id @default(cuid())
  contractorId       String
  contractor         Contractor        @relation(fields: [contractorId], references: [id])
  name               String
  address            String?
  clientContactName  String?
  clientContactEmail String?
  // Geofence centre + radius for GPS-verified clock-in/out. All three are
  // optional together — a site with no coordinates set skips geofence
  // enforcement entirely rather than blocking clock-in on missing data.
  latitude           Float?
  longitude          Float?
  geofenceRadiusM    Int?
  shifts             Shift[]
  incidents          Incident[]
  checkpoints        Checkpoint[]
  visitorLogEntries  VisitorLogEntry[]
  createdAt          DateTime          @default(now())

  @@index([contractorId])
}

// A scheduled slot at a site, optionally assigned to an officer. Status is
// set by hand here (unlike SiaLicence/VettingRecord, there's no external
// register to check against) — SCHEDULED/CONFIRMED come from the admin who
// built the roster, COMPLETED/MISSED/LATE come from the client's own
// confirmation (routes/client.ts) once the shift has actually happened.
model Shift {
  id                String      @id @default(cuid())
  contractorId      String
  contractor        Contractor  @relation(fields: [contractorId], references: [id])
  siteId            String
  site              Site        @relation(fields: [siteId], references: [id])
  officerId         String?
  officer           Officer?    @relation(fields: [officerId], references: [id])
  startTime         DateTime
  endTime           DateTime
  status            ShiftStatus @default(SCHEDULED)
  clientConfirmedAt DateTime?
  incidentNotes     String?
  clockInAt         DateTime?
  clockInLat        Float?
  clockInLng        Float?
  clockInAccuracyM  Float?
  clockInDistanceM  Float?
  clockOutAt        DateTime?
  clockOutLat       Float?
  clockOutLng       Float?
  clockOutAccuracyM Float?
  clockOutDistanceM Float?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([contractorId])
  @@index([siteId])
  @@index([officerId])
  @@index([startTime])
}

model Officer {
  id                 String              @id @default(cuid())
  contractorId       String
  contractor         Contractor          @relation(fields: [contractorId], references: [id])
  firstName          String
  lastName           String
  email              String?
  phone              String?
  licences           SiaLicence[]
  vettingRecords     VettingRecord[]
  qualifications     Qualification[]
  documents          Document[]
  vettingSubmissions VettingSubmission[]
  shifts             Shift[]
  incidents          Incident[]
  checkpointScans    CheckpointScan[]
  visitorLogEntries  VisitorLogEntry[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([contractorId])
}

// SIA licence held by an officer. `status` is derived by the scheduled
// expiry-check job (backend/src/jobs/checkExpiries.ts), not set by hand,
// since Vetro's whole pitch is that this is checked, not entered.
model SiaLicence {
  id            String           @id @default(cuid())
  officerId     String
  officer       Officer          @relation(fields: [officerId], references: [id])
  licenceNumber String
  sector        String
  issueDate     DateTime
  expiryDate    DateTime
  status        ComplianceStatus @default(ACTIVE)
  lastCheckedAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([officerId])
  @@index([expiryDate])
}

model VettingRecord {
  id            String           @id @default(cuid())
  officerId     String
  officer       Officer          @relation(fields: [officerId], references: [id])
  standard      String           @default("BS7858")
  completedDate DateTime
  expiryDate    DateTime?
  status        ComplianceStatus @default(ACTIVE)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([officerId])
  @@index([expiryDate])
}

// What an officer submits themselves through the self-service portal —
// Vetro still doesn't perform the BS7858 check; this is the record an
// admin reviews before turning it into (or updating) a VettingRecord.
model VettingSubmission {
  id                String           @id @default(cuid())
  officerId         String
  officer           Officer          @relation(fields: [officerId], references: [id])
  addressHistory    Json
  employmentHistory Json
  references        Json
  consentGiven      Boolean
  status            SubmissionStatus @default(PENDING_REVIEW)
  reviewedAt        DateTime?
  reviewedBy        String?
  reviewNotes       String?
  submittedAt       DateTime         @default(now())

  @@index([officerId])
}

model Qualification {
  id         String    @id @default(cuid())
  officerId  String
  officer    Officer   @relation(fields: [officerId], references: [id])
  name       String
  issuedBy   String?
  issueDate  DateTime?
  expiryDate DateTime?
  createdAt  DateTime  @default(now())

  @@index([officerId])
}

model Document {
  id         String   @id @default(cuid())
  officerId  String
  officer    Officer  @relation(fields: [officerId], references: [id])
  kind       String
  s3Key      String
  uploadedAt DateTime @default(now())

  @@index([officerId])
}

// Filed by whichever officer was on-site — the one feature every guard
// management product (Silvertrac, Trackforce, TimeGate+) treats as core,
// and doubles as extra evidence for an ACS inspection alongside the
// compliance record. photoKeys are S3 keys from the same presigned-upload
// flow as Document (lib/documents.ts), just under an "incidents/" prefix.
model Incident {
  id           String           @id @default(cuid())
  contractorId String
  contractor   Contractor       @relation(fields: [contractorId], references: [id])
  siteId       String
  site         Site             @relation(fields: [siteId], references: [id])
  officerId    String
  officer      Officer          @relation(fields: [officerId], references: [id])
  category     IncidentCategory
  description  String
  occurredAt   DateTime
  photoKeys    String[]
  createdAt    DateTime         @default(now())

  @@index([contractorId])
  @@index([siteId])
  @@index([officerId])
  @@index([occurredAt])
}

// A patrol route is just a named set of checkpoints at a site — no GPS
// geofencing or NFC hardware assumed, an officer taps "Scan" from their
// phone when they physically reach each one, same as Vetro's other
// self-service actions.
model Checkpoint {
  id           String           @id @default(cuid())
  contractorId String
  contractor   Contractor       @relation(fields: [contractorId], references: [id])
  siteId       String
  site         Site             @relation(fields: [siteId], references: [id])
  name         String
  description  String?
  scans        CheckpointScan[]
  createdAt    DateTime         @default(now())

  @@index([contractorId])
  @@index([siteId])
}

model CheckpointScan {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id])
  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id])
  officerId    String
  officer      Officer    @relation(fields: [officerId], references: [id])
  scannedAt    DateTime   @default(now())

  @@index([contractorId])
  @@index([checkpointId])
  @@index([officerId])
  @@index([scannedAt])
}

// A site-level sign-in/out register — common wherever a site itself
// controls who's allowed past reception, recorded by whichever officer is
// on duty rather than the visitor self-serving it.
model VisitorLogEntry {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id])
  siteId       String
  site         Site       @relation(fields: [siteId], references: [id])
  officerId    String
  officer      Officer    @relation(fields: [officerId], references: [id])
  visitorName  String
  company      String?
  purpose      String?
  hostName     String?
  signedInAt   DateTime   @default(now())
  signedOutAt  DateTime?

  @@index([contractorId])
  @@index([siteId])
  @@index([officerId])
  @@index([signedInAt])
}

// Every write an ACS inspector or client export might need to prove happened.
// contractorId is nullable only because it postdates this table — every
// call site that exists has one available and always passes it now (see
// backend/src/lib/audit.ts); older rows from before this column existed
// just show with no tenant attributed.
model AuditLogEntry {
  id           String   @id @default(cuid())
  contractorId String?
  actorEmail   String
  action       String
  entityType   String
  entityId     String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([contractorId, createdAt])
}
