# Local Postgres for development (docker run -p 5432:5432 postgres:16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vetro"

PORT=3001

# Set to "true" only for local development to bypass Cognito verification.
SKIP_AUTH=true

# Required when SKIP_AUTH is not "true" — see infra/lib/auth-stack.ts.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# Optional — powers the AI second-opinion review in the BS7858/BPSS
# compliance panel (backend/src/lib/groq.ts). Leave unset to have that
# endpoint return 503 rather than fail hard.
GROQ_API_KEY=
