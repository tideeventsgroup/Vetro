VITE_API_URL=http://localhost:3001

# Set to "true" only for local development, to match the backend's
# SKIP_AUTH and skip the Cognito login screen entirely.
VITE_SKIP_AUTH=true

# Required when VITE_SKIP_AUTH is not "true".
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Production base domain — the tenant slug is read from the subdomain in
# front of this (clyde-coast.vetro.co.uk -> "clyde-coast"). Only needed once
# a real domain exists; leave unset for local dev.
VITE_BASE_DOMAIN=

# Fallback tenant slug when running on plain "localhost" (no subdomain to
# read). To develop against a specific tenant instead, visit
# http://<slug>.localhost:5173 and this is ignored.
VITE_DEV_TENANT_SLUG=clyde-coast

# SKIP_AUTH-only stand-ins for a real ID token's custom:role/custom:officer_id
# claims (see src/lib/dev.ts). Leave both unset to develop as an ADMIN.
# Set VITE_DEV_ROLE=OFFICER and VITE_DEV_OFFICER_ID=<an Officer.id from the
# seed data> to develop against the officer self-service portal instead.
VITE_DEV_ROLE=
VITE_DEV_OFFICER_ID=
