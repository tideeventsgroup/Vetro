VITE_API_URL=http://localhost:3001

# Set to "true" only for local development, to match the backend's
# SKIP_AUTH and skip the Cognito login screen entirely.
VITE_SKIP_AUTH=true

# Required when VITE_SKIP_AUTH is not "true".
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Production base domain — the tenant slug is read from the subdomain in
# front of this (clyde-coast.vetro.co.uk -> "clyde-coast"), taking priority
# over the /:tenant path below once it's set. Only needed once a real
# domain exists; leave unset for local dev and for the current no-custom-
# domain deployment.
VITE_BASE_DOMAIN=

# Every route is nested under /:tenant (see src/App.tsx), so visiting
# http://localhost:5173/<slug> is normally how you pick a tenant locally —
# no config needed. This is only the fallback for a bare "/" with no path
# (NoTenant.tsx redirects here instead of showing its "visit your org's
# link" message); to test that page for real, leave this blank. To
# exercise the subdomain path instead, visit http://<slug>.localhost:5173.
VITE_DEV_TENANT_SLUG=clyde-coast

# SKIP_AUTH-only stand-ins for a real ID token's custom:role/custom:officer_id
# claims (see src/lib/dev.ts). Leave both unset to develop as an ADMIN.
# Set VITE_DEV_ROLE=OFFICER and VITE_DEV_OFFICER_ID=<an Officer.id from the
# seed data> to develop against the officer self-service portal instead.
VITE_DEV_ROLE=
VITE_DEV_OFFICER_ID=
